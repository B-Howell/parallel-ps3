# The core's own game patches (libretro_patch.yml), compiled into the core and
# written to patches/libretro_patch.yml in the config dir beside RPCS3's
# patch.yml (install_patches in libretro_core.cpp), when missing or different.
function(libretro_embed_core_patches out_file)
    set(db "${CMAKE_CURRENT_SOURCE_DIR}/libretro_patch.yml")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${db}")
    file(READ "${db}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR size "${hex_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    file(WRITE "${out_file}.tmp"
        "// Generated by embed_core_patches.cmake from libretro_patch.yml\n"
        "#include <cstddef>\n\n"
        "extern const unsigned char g_libretro_core_patch_yml[] = {${bytes}0};\n"
        "extern const std::size_t g_libretro_core_patch_yml_size = ${size};\n")
    file(COPY_FILE "${out_file}.tmp" "${out_file}" ONLY_IF_DIFFERENT)
endfunction()
